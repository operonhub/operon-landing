# ── Envío de consultas del formulario (Resend) ──────────────────────────────
# 1. Creá una cuenta en https://resend.com
# 2. Generá una API key en https://resend.com/api-keys
# 3. Pegala acá (local) y en Vercel → Settings → Environment Variables
RESEND_API_KEY=

# Destino de las consultas. Por defecto: admin@operonhub.com
CONTACT_TO=admin@operonhub.com

# Remitente. Hasta verificar el dominio en Resend, dejá el sandbox
# (onboarding@resend.dev solo entrega al dueño de la cuenta).
# Una vez verificado operonhub.com en https://resend.com/domains, cambiá a:
# CONTACT_FROM="Operon <noreply@operonhub.com>"
CONTACT_FROM="Operon <onboarding@resend.dev>"

# ── Leads /contanos-tu-proceso → Google Sheets ──────────────────────────────
# Los envíos del formulario nativo se guardan en una Google Sheet privada a
# través de un Google Apps Script publicado como Web App.
# Guía paso a paso: docs/configuracion-formulario-google-sheets.md
#
# URL del Web App del Apps Script (termina en /exec). Solo servidor: nunca
# se expone en el navegador.
GOOGLE_SHEETS_WEBHOOK_URL=
# Secreto compartido entre este servidor y el Apps Script. Debe coincidir con
# la Script Property SHARED_SECRET del Apps Script. Generá un valor largo y
# aleatorio. No lo publiques ni lo pongas en el repo.
GOOGLE_SHEETS_WEBHOOK_SECRET=

# ── Meta Pixel (opcional) ───────────────────────────────────────────────────
# Si lo configurás, se carga el pixel y se emite el evento estándar "Lead"
# recién cuando Google Sheets confirma que el registro se guardó.
# Si lo dejás vacío, no se carga nada. No inventes un ID: pegá el real de tu
# cuenta de Meta Business (Administrador de eventos).
NEXT_PUBLIC_META_PIXEL_ID=
